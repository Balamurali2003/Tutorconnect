{
  "name": "tutorconnect-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm run dev",
    "start:website": "cd website && pnpm run dev",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "dev:all": "concurrently \"npm run start:server\" \"npm run start:client\" \"npm run start:website\"",
    "build": "cd client && npm run build",
    "build:all": "cd client && npm run build && cd ../website && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}